# Set up and run VisionEval

# Unload VE framework if already present to allow update
for ( ve.package in c("VEBase","VEModel","visioneval") ) {
  unloadNamespace(ve.package) # no error if package namespace not loaded; will detach if package is attached (on search path)
}

# Update visioneval
# Find usable repositories
# Default repository list
ve.repos <- c("https://packages.visioneval.org","https://cloud.r-project.org")
local.repos <- Sys.getenv("VE_REPOS","ve-repos.cnf") # Override for development
if ( ! file.exists(local.repos) ) {
  warning("VE_REPOS is defined but file ",local.repos," does not exist; trying default.")
  local.repos <- "ve-repos.cnf" # Fall back to default repository locations
}
if ( file.exists(local.repos) ) {
  ve.repos <- c(grep("(^\\s*#\\s*)|(^\\s*$)",readLines(local.repos),invert=TRUE,value=TRUE),ve.repos)
} # the contents of ve-repos.cnf is one url per line suitable for use with install.packages or update.packages
# The first URL in ve-repos.cnf will be checked first, then the rest
# in order, followed finally by the online default URL

# Load the installation driver (bare) into whatever user-writable R library exists
if ( ! require(VEBase,quietly=TRUE) ) {
  utils::install.packages("VEBase",lib.loc=.libPaths()[1],repos=ve.repos)
  if ( ! require(VEBase,quietly=TRUE) ) {
    stop("VEBase is not available")
  }
}
message("Updating VisionEval packages and dependencies...") # TODO: only show message if there are updates
utils::update.packages(lib.loc=.libPaths()[1],repos=ve.repos) # Will prompt user to update all out of date packages, includng VEBase itself
# .libPaths()[1] will be first library from R_LIBS_USER

"VEBase::startVisionEval()"
